# Frontend environment variables (example)
# Copy this file to .env.local and fill in your values

# Database connection string (Neon/Postgres) - needed for API routes
DATABASE_URL=postgresql://<username>:<password>@<host>:5432/<database>?sslmode=require

# SSL for database connection (false in local dev, true in production/Vercel)
DB_SSL=false

# JWT secret for token verification in API routes
JWT_SECRET=change_me_to_a_strong_secret

# Public API base URL — DEBE estar vacío ("") para que las llamadas fetch
# sean relativas (ej. /api/productos) y se resuelvan en el mismo servidor/dominio,
# eliminando problemas de CORS en producción (Vercel).
NEXT_PUBLIC_API_BASE=

# WhatsApp number for order notifications (include country code, no +)
# Formato: 521XXXXXXXXXX (México) sin signos
NEXT_PUBLIC_WHATSAPP_NUMBER=521234567890