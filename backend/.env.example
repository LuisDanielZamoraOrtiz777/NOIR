# Backend environment variables (example)
# Replace values with your Neon/Postgres and secret keys for production.

# Postgres connection string (Neon)
DATABASE_URL=postgresql://<username>:<password>@<host>:5432/<database>?sslmode=require

# If using Neon with self-signed certs set DB_SSL to true
DB_SSL=true

# JWT secret used to sign tokens (change to a strong secret)
JWT_SECRET=change_me_to_a_strong_secret

# Frontend origin allowed by CORS (set to your production frontend URL)
FRONTEND_ORIGIN=https://tu-frontend.vercel.app
